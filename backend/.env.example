# ============================================================
# TomEase Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)
# ============================================================

# --- PostgreSQL Database ---
# Get from Supabase (supabase.com) or Neon (neon.tech) — both free
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_db

# --- Cloudflare R2 Object Storage ---
# Get from: dash.cloudflare.com → R2 → Manage API Tokens
# Falls back to local disk storage if not set
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tomato-disease-models

# --- Dataset Storage ---
# Folder to store the datasets (user scans) and generated gradcams locally
# DATASET_STORAGE_PATH=./storage

# --- Third-Party Integrations ---
# Get from: agromonitoring.com (Free tier for satellite NDVI)
# AGROMONITORING_API_KEY=

# --- Admin Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This key protects the /admin/upload-model endpoint
ADMIN_API_KEY=generate_a_random_32_char_key_here

# --- Model Path (Optional) ---
# Only set this if you baked the .pth file into the Docker image
# If not set, the API starts without a model (upload it via /admin/upload-model)
# MODEL_PATH=/app/models/model.pth

# --- Model Download Source ---
# Option 1: Hugging Face (recommended — fast, reliable, free)
# Set to: "username/repo-name"
# Example: MODEL_DRIVE_ID=abhijit/tomease-model
#
# Option 2: Google Drive (fallback — slower, limited bandwidth)
# Set to: Google Drive file ID from https://drive.google.com/file/d/{FILE_ID}/view
# Example: MODEL_DRIVE_ID=1tOJLCsnL0W4un45cXXNRLmGVMUEDHYmq
#
# Backend tries HuggingFace first, then falls back to Google Drive
MODEL_DRIVE_ID=abhijit/tomease-model

# --- Environment ---
ENVIRONMENT=production
